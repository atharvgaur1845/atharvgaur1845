<div class="note-tbl" tabindex="0" role="region" aria-label="Table, scrolls sideways on narrow screens"><table><slot /></table></div>
<style is:global>
  .note-tbl { overflow-x: auto; margin: 18px 0; border: 1px solid var(--line); background: var(--surface); }
  .note-tbl table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.45; }
  .note-tbl th, .note-tbl td { text-align: left; vertical-align: top; padding: 9px 12px; border-bottom: 1px solid var(--line); }
  .note-tbl thead th { font: 600 11px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); background: var(--bg); white-space: nowrap; }
  .note-tbl td:not(:first-child), .note-tbl th:not(:first-child) { font-variant-numeric: tabular-nums; }
  .note-tbl tr:last-child td { border-bottom: 0; }
</style>
