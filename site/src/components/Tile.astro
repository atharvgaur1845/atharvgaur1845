---
import type { CollectionEntry } from 'astro:content';
import TileViz from './TileViz.astro';
import LockedTile from './LockedTile.astro';
interface Props { entry: CollectionEntry<'entries'> }
const e = Astro.props.entry.data;
const locked = e.status === 'confidential';
const [eyebrowA, eyebrowB] = e.chips;
const blurb = locked ? e.lab : e.finding;
const KIND = { research: 'research', achievement: 'achievement', project: 'project', oss: 'open source' } as const;
const STATUS = { published: 'published', 'in-progress': 'in progress', confidential: 'confidential' } as const;
const meta = [KIND[e.kind], e.span === 'S' ? undefined : (e.venue ?? STATUS[e.status]), e.year].filter(Boolean).join(' · ');
const pal = e.palette;
const o = e.oss;
const total = o?.groups?.reduce((n, g) => n + g.prs.length, 0) ?? 0;
const segCol = ['var(--c-accent)', 'var(--c-accent2)', 'color-mix(in srgb, var(--c-accent) 55%, white)', 'color-mix(in srgb, var(--c-accent2) 55%, white)'];
const style = pal ? `--c-bg:${pal.bg};--c-tint:${pal.tint};--c-accent:${pal.accent};--c-accent2:${pal.accent2}` : undefined;
---
{o ? (
  <article class:list={['tile', 'plain', `span-${e.span}`, `kind-${e.kind}`]} data-tile={e.id} data-kind={e.kind} style={style}>
    <div class="card plain-card">
      <div class="eyebrow mono" data-text><span>{o.eyebrow}</span><span class="venue">{o.right}</span></div>
      <h3 id={`t-${e.id}`} data-text><a class="tl" href={o.href}>{e.title}</a></h3>
      <p class="sub" data-text>{e.finding}</p>
      {o.groups && (
        <>
          <div class="bar" role="img" aria-label={`${total} merged pull requests by theme`}>
            {o.groups.map((g, i) => <span style={`flex:${g.prs.length};background:${segCol[i % 4]}`} title={`${g.name} ${g.prs.length}`}></span>)}
          </div>
          <div class="acc" data-text>
            {o.groups.map((g, i) => (
              <details>
                <summary><span class="sw" style={`background:${segCol[i % 4]}`}></span><span class="gn">{g.name}</span><span class="n mono">{g.prs.length}</span></summary>
                <ul class="prs">{g.prs.map((n) => <li><a href={`${o.base}${n}`} rel="noopener">#{n}</a></li>)}</ul>
              </details>
            ))}
          </div>
        </>
      )}
      {o.rows && (
        <ul class="rows" data-text>
          {o.rows.map((r) => <li><a href={r.url} rel="noopener"><span class="rt">{r.title}</span><span class="ar" aria-hidden="true">↗</span></a></li>)}
        </ul>
      )}
    </div>
    <button class="pip" type="button" data-pip={e.id} aria-label={`Ask Probe about ${e.title}`}>?</button>
  </article>

) : locked ? (
  <LockedTile entry={Astro.props.entry} />
) : (
<article class:list={['tile', `span-${e.span}`, `kind-${e.kind}`, { locked }]} data-tile={e.id} data-kind={e.kind} style={style}>
  <a class="card" href={`/p/${e.id}/`}>
    <div class="poster">
      <div class="eyebrow mono" data-text><span>{eyebrowA}</span><span class="venue">{eyebrowB}</span></div>
      <h3 id={`t-${e.id}`} data-text>{e.title}</h3>
      <p class="sub" data-text>{blurb}</p>
      <hr class="rule" />
      <div class="dwrap"><div class="diagram" data-poster={e.id} aria-hidden="true">
        <TileViz id={e.id} />
      </div></div>
    </div>
    <div class="foot">
      <div data-text>
        <p class="ft">{e.title}</p>
        <p class="meta">{meta}</p>
      </div>
      <span class="go" data-text aria-hidden="true">{locked ? 'i' : '↗'}</span>
      <span class="sr-only">{locked ? 'More info' : 'Open details'}</span>
    </div>
  </a>
  <button class="pip" type="button" data-pip={e.id} aria-label={`Ask Probe about ${e.title}`}>?</button>
</article>
)}
<style>
  .tile { grid-column: span 12; min-width: 0; position: relative; }
  .card {
    display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--ink);
    background: var(--c-bg, var(--surface)); border: var(--bw) solid var(--ink); border-radius: var(--r-tile);
    box-shadow: var(--sh-tile); position: relative; overflow: hidden;
    transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--kc); z-index: 1; }
  .kind-research { --kc: var(--kind-research); } .kind-achievement { --kc: var(--kind-achievement); }
  .kind-project { --kc: var(--kind-project); } .kind-oss { --kc: var(--kind-oss); }
  .card:hover, .card:focus-visible {
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--c-accent, var(--accent)) 45%, var(--shadow));
  }
  .dwrap { margin-top: auto; overflow: hidden; contain: paint; }
  .dwrap .diagram { transition: transform .6s cubic-bezier(.22, .61, .36, 1); transform-origin: center; will-change: transform; backface-visibility: hidden; transform: translateZ(0); }
  .card:hover .diagram, .card:focus-visible .diagram { transform: translateZ(0) scale(1.025); }
  @media (max-width: 819px) {
    .dwrap { overflow-x: auto; }
    .card:hover .diagram, .card:focus-visible .diagram { transform: translateZ(0); }
  }
  .span-L :global(svg.tz) { max-width: 400px; margin-inline: auto; }
  .rule { width: 40%; transition: width .5s cubic-bezier(.2, .8, .2, 1); }
  .card:hover .rule, .card:focus-visible .rule { width: 100%; }
  h3, .ft { transition: color .25s; }
  .card:hover h3, .card:focus-visible h3, .card:hover .ft, .card:focus-visible .ft { color: var(--c-accent, var(--ink)); }
  .go { transition: transform .25s, background-color .25s, color .25s; }
  .card:hover .go, .card:focus-visible .go { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) {
    .card:hover .diagram, .card:focus-visible .diagram, .card:hover .go, .card:focus-visible .go { transform: translateZ(0); }
    .rule { width: 100%; transition: none; }
  }
  .card:focus-visible { outline: 2px solid var(--c-accent, var(--accent)); outline-offset: 3px; }
  .card:active { transform: translateY(1px); }
  .locked .card { border-style: dashed; }
  .poster { padding: 16px 16px 12px; display: flex; flex-direction: column; flex: 1; }
  .eyebrow { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; line-height: 1.3; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
  .eyebrow .venue { color: var(--c-accent, var(--accent)); text-align: right; }
  h3 { font: 700 26px/1.05 var(--font-body); letter-spacing: -.02em; margin: 10px 0 8px; text-wrap: balance; overflow-wrap: anywhere; }
  .span-M h3 { font-size: 32px; } .span-L h3 { font-size: 44px; }
  .sub { font-size: 14px; line-height: 1.45; }
  .rule { border: 0; height: 2px; background: var(--c-accent, var(--accent)); margin: 12px 0; }
  .diagram {
    min-height: 96px; display: grid; place-items: center; color: var(--muted);
    border: 1px solid var(--line); background-color: #fff; padding: 6px 8px;
    background-image: linear-gradient(to right, var(--grid) 1px, transparent 1px), linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 16px 16px; font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
  }
  .span-L .diagram { min-height: 140px; }
  .diagram span { background: var(--surface); padding: 2px 6px; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-top: 1px solid var(--line); background: var(--c-tint, var(--surface)); }
  .ft { font: 600 20px/1.2 var(--font-body); } .span-S .ft, .span-M .ft { font-size: 17px; }
  .go { flex: none; width: 40px; height: 40px; display: grid; place-items: center; border: 1.5px solid; border-radius: var(--r-tile); font: 600 18px/1 var(--font-mono); }
  .go { color: var(--c-accent, var(--ink)); border-color: var(--c-accent, var(--ink)); }
  .card:hover .go, .card:focus-visible .go { background: var(--c-accent, var(--accent)); color: #fff; }
  :global(html[data-probe-pips]) .eyebrow { padding-right: 28px; }
  @media (min-width: 720px) {
    .span-S, .span-M { grid-column: span 6; } .span-L { grid-column: span 12; }
  }
  @media (min-width: 1024px) {
    .span-S { grid-column: span 3; } .span-M { grid-column: span 4; } .span-L { grid-column: span 6; }
  }
  .plain-card { padding: 16px; gap: 0; }
  .plain .card:hover, .plain .card:focus-within { box-shadow: 8px 8px 0 color-mix(in srgb, var(--c-accent, var(--accent)) 45%, var(--shadow)); }
  .tl { color: inherit; text-decoration: none; }
  .tl:hover, .tl:focus-visible { color: var(--c-accent, var(--accent)); text-decoration: underline; }
  .plain h3 { font-size: 26px; }
  .plain.span-L h3 { font-size: 36px; }
  .bar { display: flex; height: 12px; gap: 2px; margin: 14px 0 10px; border: 1.5px solid var(--ink); background: #fff; }
  .bar span { min-width: 2px; }
  details { border-top: 1px solid var(--line); }
  summary { display: flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: 8px; font: 600 16px var(--font-mono); color: var(--c-accent, var(--ink)); }
  details[open] summary::after { content: '\2212'; }
  .sw { width: 10px; height: 10px; flex: none; border: 1px solid var(--ink); }
  .gn { flex: 1; min-width: 0; }
  .n { color: var(--muted); }
  .prs { display: flex; flex-wrap: wrap; gap: 4px 6px; padding: 0 0 12px 20px; }
  .prs a, .rows a { color: var(--c-accent, var(--accent)); }
  .prs a { display: inline-flex; align-items: center; min-height: 32px; padding: 0 8px; border: 1px solid var(--line); background: #fff; text-decoration: none; font: 400 13px var(--font-mono); }
  .rows { font-size: 15px; line-height: 1.4; margin-top: 14px; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 8px 0; color: var(--ink); text-decoration: none; }
  .rows .rt { transition: transform .25s, color .25s; overflow-wrap: anywhere; }
  .rows a:hover .rt, .rows a:focus-visible .rt { transform: translateX(4px); color: var(--c-accent, var(--accent)); }
  .rows .ar { color: var(--c-accent, var(--ink)); }
  @media (prefers-reduced-motion: reduce) { .rows a:hover .rt, .rows a:focus-visible .rt { transform: none; } }
</style>
