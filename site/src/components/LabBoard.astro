---
import { getCollection } from 'astro:content';
const rows = (await getCollection('lab')).map((r) => r.data).sort((a, b) => a.order - b.order);
---
<aside class="board" data-probe-board aria-labelledby="h-bench">
  <h2 id="h-bench" class="pixel">ON THE BENCH</h2>
  <ul>
    {rows.map((r) => (
      <li>
        <a href={`/p/${r.entry}/`}>
          <span class="top"><span class="led" aria-hidden="true"></span><strong>{r.title}</strong><span class="chip">{r.status}</span></span>
          <span class="line" title={r.line}>{r.line}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<style>
  .board { background: var(--surface); border: var(--bw) solid var(--ink); border-radius: var(--r-tile); box-shadow: var(--sh-tile); padding: 16px; }
  h2 { font: 600 var(--fs-shelf)/1 var(--font-pixel); letter-spacing: .06em; margin-bottom: 8px; }
  li + li { border-top: 1px solid var(--line); }
  a { display: block; padding: 10px 0; min-height: 44px; color: var(--ink); text-decoration: none; }
  a:hover .line, a:focus-visible .line { -webkit-line-clamp: unset; line-clamp: unset; }
  a:hover strong { text-decoration: underline; }
  .top { display: flex; align-items: center; gap: 10px; }
  .top .chip { margin-left: auto; }
  .line { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; margin-top: 4px; font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--muted); }
</style>
