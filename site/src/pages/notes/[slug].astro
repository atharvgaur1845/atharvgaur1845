---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProbeData from '../../components/ProbeData.astro';
import NoteTable from '../../components/NoteTable.astro';
import { getNotes, getEntries, SHELF_LABEL } from '../../lib/data';
export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}
const { note } = Astro.props;
const entries = await getEntries();
const entry = entries.find((e) => e.data.id === note.data.entry)!;
const { Content, headings, remarkPluginFrontmatter } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
const words = (note.body ?? '').replace(/\{\/\*[\s\S]*?\*\//g, '').split(/\s+/).filter(Boolean).length;
const minutes = note.data.readingTime ?? Math.max(1, Math.round(words / 200));
const shelf = SHELF_LABEL[entry.data.shelf].replace(' SHELF', '').toLowerCase();
const date = note.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const KIND = { research: 'research', achievement: 'achievement', project: 'project', oss: 'open source' } as const;
const pal = entry.data.palette;
const style = pal ? `--c-accent:${pal.accent};--c-tint:${pal.tint};--c-bg:${pal.bg}` : undefined;
---
<Base title={`${note.data.title} | Atharv Sharma`} description={note.data.subtitle} image={`/og/${entry.data.id}.png`} noindex={note.data.draft}>
  <Nav />
  <main id="main" class="wrap note-wrap" style={style}>
    <p class="crumb"><a href={`/p/${entry.data.id}/`}>← back to {entry.data.title} on the {shelf} shelf</a></p>
    <header class="note-head">
      <h1>{note.data.title}</h1>
      {note.data.subtitle && <p class="sub">{note.data.subtitle}</p>}
      <p class="meta-row">
        <time datetime={note.data.date.toISOString().slice(0, 10)}>{date}</time>
        <span aria-hidden="true">·</span><span>{minutes} min read</span>
        <span class="chip">{KIND[entry.data.kind]}</span>
        {note.data.draft && <span class="chip draft">Draft</span>}
      </p>
    </header>
    <div class="note-grid">
      <nav class="toc" aria-label="Contents in this note">
        <details>
          <summary class="pixel">CONTENTS</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      </nav>
      <article class="note">
        <Content components={{ table: NoteTable }} />
      </article>
    </div>
  </main>
  <Footer />
  <ProbeData />
  <script is:inline>if (matchMedia('(min-width: 1100px)').matches) document.querySelector('.toc details').open = true;</script>
</Base>
<style is:global>
  .note-wrap { margin-top: 32px; }
  .crumb { font-size: 14px; } .crumb a { display: inline-flex; align-items: center; min-height: 44px; }
  .note-head h1 { font: 700 clamp(30px, 5vw, 44px)/1.1 var(--font-body); letter-spacing: -.02em; max-width: 24ch; text-wrap: balance; }
  .note-head .sub { margin-top: 10px; color: var(--muted); max-width: var(--measure-note); }
  .meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 14px; font-size: var(--fs-meta); color: var(--muted); }
  .chip.draft { background: var(--led); color: #fff; border-color: var(--led); }
  .note-grid { display: grid; gap: 24px; margin-top: 28px; }
  .toc { border: 1px solid var(--line); background: var(--surface); padding: 4px 14px; align-self: start; }
  .toc summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: 12px; }
  .toc ol { list-style: none; padding: 0 0 10px; display: grid; gap: 2px; counter-reset: t; }
  .toc a { display: inline-flex; align-items: center; min-height: 36px; font-size: 14px; color: var(--ink); text-decoration: none; }
  .toc a:hover { color: var(--accent); text-decoration: underline; }
  .note { min-width: 0; font-size: var(--fs-note); line-height: var(--lh-note); }
  .note > * { max-width: var(--measure-note); }
  .note h2 { font: 700 26px/1.2 var(--font-body); margin: 40px 0 12px; scroll-margin-top: 64px; }
  .note p, .note ul, .note ol { margin-top: 14px; }
  .note ul { list-style: disc; padding-left: 24px; } .note ol { padding-left: 24px; }
  .note li + li { margin-top: 6px; }
  .note code { background: var(--line); padding: 1px 5px; border-radius: 2px; }
  .note .note-tbl, .note .breakout { max-width: 900px; }
  .note .breakout { margin: 20px 0; }
  .note a { overflow-wrap: anywhere; }
  @media (min-width: 1100px) {
    .note-grid { grid-template-columns: 220px minmax(0, 1fr); gap: 48px; }
    .toc { position: sticky; top: calc(var(--nav-h) + 24px); }
  }
</style>
